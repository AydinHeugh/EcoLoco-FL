{
  "expo": {
    "name": "EcoLoco",
    "slug": "EcoLoco",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "EcoLoco needs camera access so you can take photos of plants to identify them."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F4EA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-image-picker",
        {
          "cameraPermission": "EcoLoco needs camera access so you can take photos of plants to identify them."
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "EcoLoco uses your location once to find your school's ZIP code and plants seen nearby. It is rounded to about 1 km and never saved."
        }
      ],
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F4EA"
        }
      ]
    ]
  }
}
