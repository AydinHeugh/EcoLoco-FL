# Photo identification only. Catalog, audits, recommendations and proposals work without keys.
PLANTNET_API_KEY=
OPENAI_API_KEY=
# Comma-separated web app origins. Native clients do not require a CORS origin.
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:4173,http://127.0.0.1:4173
# Per-process photo-identification budgets. One production worker preserves shared limits.
IDENTIFY_PER_MINUTE=6
IDENTIFY_TOTAL_PER_MINUTE=20
IDENTIFY_TOTAL_PER_DAY=200
# Enable only for local debugging.
ECOLOCO_DEV=0
PORT=5000
